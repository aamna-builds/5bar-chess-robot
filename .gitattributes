# Text files: normalise line endings
*.m    text eol=lf
*.py   text eol=lf
*.cpp  text eol=lf
*.h    text eol=lf
*.ino  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.csv  text eol=lf
*.sh   text eol=lf
*.m linguist-language=MATLAB

# Binary media
*.png  binary
*.jpg  binary
*.gif  binary
*.mp4  binary
